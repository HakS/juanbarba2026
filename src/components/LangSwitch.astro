---
import { getLangFromUrl, languages, localizedPath, type Lang } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);

// Strip locale prefix from current path so we can rebuild it for each language.
const currentPath = Astro.url.pathname;
const isEs = currentPath === '/es' || currentPath === '/es/' || currentPath.startsWith('/es/');
const basePath = isEs ? (currentPath.replace(/^\/es/, '') || '/') : currentPath;

const hrefFor: Record<Lang, string> = {
  en: localizedPath('en', basePath),
  es: localizedPath('es', basePath),
};
---

<div
  class="flex items-center gap-1 text-[10px] font-mono-label uppercase tracking-[0.2em]"
  data-lang-switch
>
  {
    (Object.keys(languages) as Lang[]).map((code, i) => (
      <>
        {i > 0 && <span class="text-on-surface/20">/</span>}
        <a
          href={hrefFor[code]}
          data-lang={code}
          aria-current={code === lang ? 'page' : undefined}
          class:list={[
            'px-1 transition-colors',
            code === lang
              ? 'text-on-surface'
              : 'text-on-surface-variant hover:text-primary',
          ]}
        >
          {languages[code]}
        </a>
      </>
    ))
  }
</div>

<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-lang-switch] [data-lang]').forEach((el) => {
    el.addEventListener('click', () => {
      const choice = el.dataset.lang;
      if (choice === 'en' || choice === 'es') {
        try {
          localStorage.setItem('lang', choice);
        } catch (e) {}
      }
    });
  });
</script>
