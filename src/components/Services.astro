---
import { getLangFromUrl, useTranslations } from '../i18n/ui';

interface Props {
  headingLevel?: 'h1' | 'h2';
}

const { headingLevel = 'h2' } = Astro.props as Props;
const t = useTranslations(getLangFromUrl(Astro.url)).services;
const HeadingTag = headingLevel;
---

<section
  id="services"
  class="max-w-[1280px] mx-auto px-6 sm:px-10 md:px-16 py-section-gap"
>
  <div class="max-w-3xl mb-20">
    <span
      class="text-[10px] font-mono-label text-primary uppercase tracking-[0.3em] mb-6 block"
      >{t.eyebrow}</span
    >
    <HeadingTag class="font-h1 text-h1 text-on-surface uppercase headline-wide mb-10">
      {t.title}
    </HeadingTag>
    <p class="text-body-lg text-on-surface-variant leading-relaxed">{t.intro}</p>
  </div>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 mb-24">
    {
      t.bullets.map((b, i) => (
        <article
          class="glass-panel rounded-2xl p-10 space-y-4 border border-on-surface/10 hover:border-primary/40 transition-colors"
          data-reveal
          style={`--reveal-delay: ${i * 80}`}
        >
          <h3 class="font-h3 text-lg text-on-surface uppercase tracking-wider font-bold">
            {b.title}
          </h3>
          <p class="text-on-surface-variant text-sm leading-relaxed">{b.body}</p>
        </article>
      ))
    }
  </div>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-12 pt-12 border-t border-on-surface/10">
    <div>
      <h3 class="text-sm font-mono-label uppercase tracking-[0.2em] text-primary mb-6">
        {t.audienceTitle}
      </h3>
      <ul class="space-y-3 text-on-surface-variant leading-relaxed">
        {t.audience.map((line) => (
          <li class="flex gap-3">
            <span
              class="material-symbols-outlined text-primary text-base shrink-0 mt-1"
              aria-hidden="true"
            >
              check
            </span>
            <span>{line}</span>
          </li>
        ))}
      </ul>
    </div>
    <div>
      <h3 class="text-sm font-mono-label uppercase tracking-[0.2em] text-primary mb-6">
        {t.ownershipTitle}
      </h3>
      <p class="text-on-surface-variant leading-relaxed">{t.ownership}</p>
    </div>
  </div>
</section>
