---
import { getLangFromUrl, useTranslations } from '../i18n/ui';

const t = useTranslations(getLangFromUrl(Astro.url)).footer;
const year = new Date().getFullYear();
---

<footer class="w-full border-t border-white/5 py-20 bg-zinc-950">
  <div
    class="max-w-[1280px] mx-auto px-16 flex flex-col md:flex-row justify-between items-center gap-10"
  >
    <div class="text-xs font-bold uppercase tracking-[0.2em] text-white/40 font-h1">
      Juan © {year}
    </div>
    <div
      class="flex gap-12 text-[10px] font-mono-label uppercase tracking-[0.2em] text-on-surface-variant"
    >
      {
        t.links.map((l) => (
          <a class="hover:text-primary transition-colors" href={l.href}>
            {l.label}
          </a>
        ))
      }
    </div>
    <div
      class="text-[10px] font-mono-label uppercase tracking-[0.2em] text-outline"
    >
      {t.tagline}
    </div>
  </div>
</footer>
