---
import { WHATSAPP_URL } from '../config/contact';
import { getLangFromUrl, useTranslations } from '../i18n/ui';

const t = useTranslations(getLangFromUrl(Astro.url)).finalCTA;
---

<section class="max-w-[1280px] mx-auto px-16 py-section-gap mb-32">
  <div
    class="glass-panel rounded-[3rem] p-24 text-center space-y-12 relative overflow-hidden border border-white/5"
  >
    <div
      class="absolute -top-32 -right-32 w-96 h-96 bg-primary/10 rounded-full blur-[120px]"
    >
    </div>
    <div
      class="absolute -bottom-32 -left-32 w-96 h-96 bg-indigo-900/10 rounded-full blur-[120px]"
    >
    </div>
    <h2
      class="font-h1 text-h1 text-on-surface uppercase headline-wide relative z-10"
    >
      {t.title}
    </h2>
    <p
      class="text-body-lg text-on-surface-variant max-w-2xl mx-auto relative z-10 opacity-80"
    >
      {t.description}
    </p>
    <a
      href={WHATSAPP_URL}
      target="_blank"
      rel="noopener"
      class="relative z-10 inline-block bg-primary text-on-primary px-12 py-6 rounded-xl font-bold text-xl indigo-glow transition-all active:scale-95 shadow-2xl shadow-primary/30"
      >{t.cta}</a
    >
  </div>
</section>
