---
import { WHATSAPP_URL } from '../config/contact';
import { getLangFromUrl, useTranslations } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang).pricing;
const cta = useTranslations(lang).hero.cta;
---

<section
  id="pricing"
  class="max-w-[1280px] mx-auto px-6 sm:px-10 md:px-16 py-section-gap"
>
  <div class="text-center mb-16">
    <span
      class="text-[10px] font-mono-label text-primary uppercase tracking-[0.3em] mb-6 block"
      >{t.eyebrow}</span
    >
    <h2 class="font-h2 text-h2 text-on-surface uppercase headline-wide mb-8">
      {t.title}
    </h2>
    <p class="text-body-lg text-on-surface-variant max-w-2xl mx-auto opacity-90">
      {t.intro}
    </p>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
    {
      t.tiers.map((tier, i) => (
        <article
          class:list={[
            'glass-panel rounded-2xl p-10 flex flex-col gap-6 border transition-all',
            'highlighted' in tier && tier.highlighted
              ? 'border-primary/50 indigo-glow'
              : 'border-on-surface/10',
          ]}
          data-reveal
          style={`--reveal-delay: ${i * 120}`}
        >
          <div>
            <h3 class="font-h3 text-h3 text-on-surface uppercase mb-3">
              {tier.name}
            </h3>
            <div class="text-3xl font-extrabold text-primary mb-1">
              {tier.time}
            </div>
            <div class="text-[10px] font-mono-label text-outline uppercase tracking-[0.2em]">
              {tier.price}
            </div>
          </div>
          <ul class="space-y-3 flex-1 text-on-surface-variant text-sm leading-relaxed">
            {tier.features.map((f) => (
              <li class="flex gap-3">
                <span
                  class="material-symbols-outlined text-primary text-base shrink-0"
                  aria-hidden="true"
                >
                  check
                </span>
                <span>{f}</span>
              </li>
            ))}
          </ul>
          <a
            href={WHATSAPP_URL}
            target="_blank"
            rel="noopener"
            data-analytics="contact_whatsapp"
            data-analytics-location={`pricing_tier_${i}`}
            class:list={[
              'mt-auto inline-block text-center px-6 py-3.5 rounded-lg font-bold text-sm transition-transform active:scale-95',
              'highlighted' in tier && tier.highlighted
                ? 'bg-primary text-on-primary shadow-xl shadow-primary/20'
                : 'border border-on-surface/20 text-on-surface hover:border-primary/50',
            ]}
          >
            {cta}
          </a>
        </article>
      ))
    }
  </div>
  <p class="text-center text-xs text-outline mt-12">{t.footnote}</p>
</section>
