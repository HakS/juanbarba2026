---
import { getLangFromUrl, useTranslations } from '../i18n/ui';

const t = useTranslations(getLangFromUrl(Astro.url)).process;
---

<section class="max-w-[1280px] mx-auto px-16 py-section-gap">
  <div class="text-center mb-24">
    <h2 class="font-h2 text-h2 text-on-surface uppercase headline-wide">
      {t.title}
    </h2>
  </div>
  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-12">
    {
      t.steps.map((s, i) => (
        <div class="space-y-6">
          <span class="text-6xl font-black text-white/5 block leading-none">
            {String(i + 1).padStart(2, '0')}
          </span>
          <h4 class="text-sm font-bold text-white uppercase tracking-wider">
            {s.title}
          </h4>
          <p class="text-on-surface-variant text-sm leading-relaxed">{s.body}</p>
        </div>
      ))
    }
  </div>
</section>
