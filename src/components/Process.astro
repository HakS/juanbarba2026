---
import { getLangFromUrl, useTranslations } from '../i18n/ui';

const t = useTranslations(getLangFromUrl(Astro.url)).process;
---

<section class="max-w-[1280px] mx-auto px-6 sm:px-10 md:px-16 py-section-gap">
  <div class="max-w-3xl mx-auto text-center mb-24">
    <span
      class="text-[10px] font-mono-label text-primary uppercase tracking-[0.3em] mb-6 block"
      >{t.eyebrow}</span
    >
    <h2 class="font-h2 text-h2 text-on-surface uppercase headline-wide mb-8">
      {t.title}
    </h2>
    <p class="text-body-lg text-on-surface-variant leading-relaxed opacity-90">
      {t.intro}
    </p>
  </div>
  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-12">
    {
      t.steps.map((s, i) => (
        <div
          class="space-y-6"
          data-reveal="x"
          style={`--reveal-delay: ${i * 180}`}
        >
          <span class="text-6xl font-black text-on-surface/5 block leading-none">
            {String(i + 1).padStart(2, '0')}
          </span>
          <h4 class="text-sm font-bold text-on-surface uppercase tracking-wider">
            {s.title}
          </h4>
          <p class="text-on-surface-variant text-sm leading-relaxed">{s.body}</p>
        </div>
      ))
    }
  </div>
</section>
