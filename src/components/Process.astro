---
const steps = [
  {
    n: '01',
    title: 'Analysis',
    body: 'A 15-minute diagnostic call to understand your manual pain points.',
  },
  {
    n: '02',
    title: 'Blueprint',
    body: 'A clear execution plan and fixed price. Zero ambiguity.',
  },
  {
    n: '03',
    title: 'Synthesis',
    body: 'I architect the tool. You watch it come to life via a private link.',
  },
  {
    n: '04',
    title: 'Handover',
    body: 'Live in 72 hours. Guided onboarding and full ownership keys.',
  },
];
---

<section class="max-w-[1280px] mx-auto px-16 py-section-gap">
  <div class="text-center mb-24">
    <h2 class="font-h2 text-h2 text-on-surface uppercase headline-wide">
      The Protocol
    </h2>
  </div>
  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-12">
    {
      steps.map((s) => (
        <div class="space-y-6">
          <span class="text-6xl font-black text-white/5 block leading-none">
            {s.n}
          </span>
          <h4 class="text-sm font-bold text-white uppercase tracking-wider">
            {s.title}
          </h4>
          <p class="text-on-surface-variant text-sm leading-relaxed">{s.body}</p>
        </div>
      ))
    }
  </div>
</section>
