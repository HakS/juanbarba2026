---
import { Image } from 'astro:assets';
import portraitImage from '../assets/images/portrait-juan.png';
import { getLangFromUrl, useTranslations } from '../i18n/ui';

interface Props {
  headingLevel?: 'h1' | 'h2';
}

const { headingLevel = 'h2' } = Astro.props as Props;
const t = useTranslations(getLangFromUrl(Astro.url)).about;
const stack = ['Angular', 'React', 'Astro', 'Node.js', 'NestJS', 'PostgreSQL', 'AWS Cloud'];
const HeadingTag = headingLevel;
const headingClasses =
  headingLevel === 'h1'
    ? 'font-h1 text-h1 uppercase headline-wide'
    : 'font-h2 text-h2 uppercase headline-wide';
---

<section id="about" class="max-w-[1280px] mx-auto px-6 sm:px-10 md:px-16 py-section-gap">
  <div class="flex flex-col md:flex-row gap-24 items-center">
    <div
      class="w-full md:w-1/3 aspect-[4/5] glass-panel rounded-2xl overflow-hidden border border-on-surface/10 grayscale hover:grayscale-0 transition-all duration-700"
      data-reveal
    >
      <Image
        class="w-full h-full object-cover contrast-125 brightness-90"
        src={portraitImage}
        alt={t.portraitAlt}
        widths={[400, 600, 800]}
        sizes="(min-width: 768px) 33vw, 100vw"
        loading="lazy"
      />
    </div>
    <div class="flex-1 space-y-10">
      <HeadingTag class={headingClasses}>{t.title}</HeadingTag>
      <div class="space-y-6 text-body-lg text-on-surface-variant">
        {t.paragraphs.map((p) => <p>{p}</p>)}
      </div>
      <div class="pt-10 border-t border-on-surface/10">
        <span
          class="text-[10px] font-mono-label text-outline uppercase tracking-[0.3em] block mb-6"
          >{t.stackLabel}</span
        >
        <div
          class="flex flex-wrap gap-4 text-xs font-mono-label text-primary uppercase"
        >
          {
            stack.map((tag) => (
              <span class="px-5 py-2.5 recessed bg-surface-container-lowest rounded-full border border-on-surface/10">
                {tag}
              </span>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
