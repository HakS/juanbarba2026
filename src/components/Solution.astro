---
import { getLangFromUrl, useTranslations } from '../i18n/ui';

const t = useTranslations(getLangFromUrl(Astro.url)).solution;
---

<section
  class="bg-surface-container-low/30 py-section-gap border-y border-white/5"
>
  <div
    class="max-w-[1280px] mx-auto px-16 flex flex-col md:flex-row items-center gap-24"
  >
    <div class="flex-1">
      <div class="recessed p-4 rounded-2xl bg-zinc-950/50">
        <img
          class="w-full h-auto rounded-xl opacity-80"
          src="/images/solution-wireframe.jpg"
          alt={t.imageAlt}
        />
      </div>
    </div>
    <div class="flex-1 space-y-12">
      <h2 class="font-h2 text-h2 text-on-surface uppercase headline-wide">
        {t.title}
      </h2>
      <div class="grid grid-cols-2 gap-10">
        {
          t.features.map((f) => (
            <div class="space-y-3">
              <h4 class="text-white font-bold text-sm uppercase tracking-wider">
                {f.title}
              </h4>
              <p class="text-on-surface-variant text-sm leading-relaxed">
                {f.body}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
