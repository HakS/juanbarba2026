---
import { Image } from 'astro:assets';
import solutionImage from '../assets/images/solution-wireframe.jpg';
import { getLangFromUrl, useTranslations } from '../i18n/ui';

const t = useTranslations(getLangFromUrl(Astro.url)).solution;
---

<section
  class="bg-surface-container-low/30 py-section-gap border-y border-on-surface/10"
>
  <div
    class="max-w-[1280px] mx-auto px-6 sm:px-10 md:px-16 flex flex-col md:flex-row items-center gap-24"
  >
    <div class="flex-1" data-reveal>
      <div class="recessed p-4 rounded-2xl bg-surface-container-lowest">
        <Image
          class="w-full h-auto rounded-xl opacity-80"
          src={solutionImage}
          alt={t.imageAlt}
          widths={[480, 800, 1200]}
          sizes="(min-width: 768px) 600px, 100vw"
          loading="lazy"
        />
      </div>
    </div>
    <div class="flex-1 space-y-12">
      <h2 class="font-h2 text-h2 text-on-surface uppercase headline-wide">
        {t.title}
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-10">
        {
          t.features.map((f) => (
            <div class="space-y-3">
              <h4 class="text-on-surface font-bold text-sm uppercase tracking-wider">
                {f.title}
              </h4>
              <p class="text-on-surface-variant text-sm leading-relaxed">
                {f.body}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
