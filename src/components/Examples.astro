---
import { getLangFromUrl, useTranslations } from '../i18n/ui';

const t = useTranslations(getLangFromUrl(Astro.url)).examples;
const [client, order, sync, booking, landing] = t.cards;
---

<section class="max-w-[1280px] mx-auto px-6 sm:px-10 md:px-16 py-section-gap">
  <div class="text-center mb-24">
    <h2 class="font-h2 text-h2 text-on-surface uppercase headline-wide">
      {t.title}
    </h2>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
    <article
      class="group glass-panel rounded-2xl overflow-hidden flex flex-col hover:border-primary/50 transition-all"
    >
      <div class="p-10 flex justify-between items-start">
        <div>
          <h4 class="font-h3 text-h3 uppercase mb-3">{client!.title}</h4>
          <p class="text-on-surface-variant">{client!.body}</p>
        </div>
        <span
          class="material-symbols-outlined text-on-surface-variant group-hover:text-primary transition-colors"
          >{client!.icon}</span
        >
      </div>
      <div class="mt-auto px-10 pb-10">
        <div
          class="h-32 bg-surface-container-lowest rounded-lg border border-on-surface/10 flex items-end p-4 gap-2 recessed"
        >
          <div class="h-1/2 w-full bg-primary/20 rounded"></div>
          <div class="h-2/3 w-full bg-primary/40 rounded"></div>
          <div class="h-full w-full bg-primary/60 rounded"></div>
          <div class="h-3/4 w-full bg-primary/40 rounded"></div>
        </div>
      </div>
    </article>

    <article
      class="group glass-panel rounded-2xl overflow-hidden flex flex-col hover:border-primary/50 transition-all"
    >
      <div class="p-10 flex justify-between items-start">
        <div>
          <h4 class="font-h3 text-h3 uppercase mb-3">{order!.title}</h4>
          <p class="text-on-surface-variant">{order!.body}</p>
        </div>
        <span
          class="material-symbols-outlined text-on-surface-variant group-hover:text-primary transition-colors"
          >{order!.icon}</span
        >
      </div>
      <div class="mt-auto px-10 pb-10">
        <div class="flex gap-4">
          <div
            class="flex-1 h-20 bg-surface-container-lowest border border-on-surface/10 rounded-lg flex items-center justify-center font-mono-label text-primary recessed"
          >
            {t.labels.pending}
          </div>
          <div
            class="flex-1 h-20 bg-surface-container-lowest border border-on-surface/10 rounded-lg flex items-center justify-center font-mono-label text-emerald-500 recessed"
          >
            {t.labels.done}
          </div>
        </div>
      </div>
    </article>

    <article
      class="group glass-panel rounded-2xl overflow-hidden flex flex-col hover:border-primary/50 transition-all"
    >
      <div class="p-10 flex justify-between items-start">
        <div>
          <h4 class="font-h3 text-h3 uppercase mb-3">{sync!.title}</h4>
          <p class="text-on-surface-variant">{sync!.body}</p>
        </div>
        <span
          class="material-symbols-outlined text-on-surface-variant group-hover:text-primary transition-colors"
          >{sync!.icon}</span
        >
      </div>
      <div class="mt-auto px-10 pb-10">
        <div class="space-y-3">
          <div
            class="w-full h-1.5 bg-on-surface/5 rounded-full overflow-hidden recessed"
          >
            <div
              class="w-2/3 h-full bg-primary shadow-[0_0_10px_rgba(99,102,241,0.5)]"
            >
            </div>
          </div>
          <div
            class="flex justify-between text-[10px] font-mono-label text-outline uppercase tracking-widest"
          >
            <span>{t.labels.syncing}</span>
            <span>65%</span>
          </div>
        </div>
      </div>
    </article>

    <article
      class="group glass-panel rounded-2xl overflow-hidden flex flex-col hover:border-primary/50 transition-all"
    >
      <div class="p-10 flex justify-between items-start">
        <div>
          <h4 class="font-h3 text-h3 uppercase mb-3">{booking!.title}</h4>
          <p class="text-on-surface-variant">{booking!.body}</p>
        </div>
        <span
          class="material-symbols-outlined text-on-surface-variant group-hover:text-primary transition-colors"
          >{booking!.icon}</span
        >
      </div>
      <div class="mt-auto px-10 pb-10">
        <div class="grid grid-cols-7 gap-2">
          <div class="h-6 bg-on-surface/5 rounded-sm recessed"></div>
          <div
            class="h-6 bg-primary rounded-sm shadow-[0_0_10px_rgba(99,102,241,0.3)]"
          >
          </div>
          <div class="h-6 bg-on-surface/5 rounded-sm recessed"></div>
          <div class="h-6 bg-on-surface/5 rounded-sm recessed"></div>
          <div
            class="h-6 bg-primary rounded-sm shadow-[0_0_10px_rgba(99,102,241,0.3)]"
          >
          </div>
          <div class="h-6 bg-on-surface/5 rounded-sm recessed"></div>
          <div class="h-6 bg-on-surface/5 rounded-sm recessed"></div>
        </div>
      </div>
    </article>

    <article
      class="group glass-panel rounded-2xl overflow-hidden flex flex-col hover:border-primary/50 transition-all"
    >
      <div class="p-10 flex justify-between items-start">
        <div>
          <h4 class="font-h3 text-h3 uppercase mb-3">{landing!.title}</h4>
          <p class="text-on-surface-variant">{landing!.body}</p>
        </div>
        <span
          class="material-symbols-outlined text-on-surface-variant group-hover:text-primary transition-colors"
          >{landing!.icon}</span
        >
      </div>
      <div class="mt-auto px-10 pb-10">
        <div
          class="h-32 bg-surface-container-lowest rounded-lg border border-on-surface/10 p-4 flex flex-col justify-between recessed"
        >
          <div class="space-y-2">
            <div class="h-2 w-1/3 bg-on-surface/20 rounded-sm"></div>
            <div class="h-2 w-2/3 bg-on-surface/10 rounded-sm"></div>
          </div>
          <div class="flex items-center justify-between">
            <div class="h-2 w-1/4 bg-on-surface/10 rounded-sm"></div>
            <div
              class="h-7 w-24 rounded-md bg-primary shadow-[0_0_12px_rgba(99,102,241,0.45)]"
            >
            </div>
          </div>
        </div>
      </div>
    </article>
  </div>
</section>
