---
---

<section class="max-w-[1280px] mx-auto px-16 py-section-gap">
  <div class="text-center mb-24">
    <h2 class="font-h2 text-h2 text-on-surface uppercase headline-wide">
      Built for Action
    </h2>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
    <article
      class="group glass-panel rounded-2xl overflow-hidden flex flex-col hover:border-primary/50 transition-all"
    >
      <div class="p-10 flex justify-between items-start">
        <div>
          <h4 class="font-h3 text-h3 uppercase mb-3">Client Management</h4>
          <p class="text-on-surface-variant">
            Tracks customer history, preferences, and total spending in one
            view.
          </p>
        </div>
        <span
          class="material-symbols-outlined text-on-surface-variant group-hover:text-primary transition-colors"
          >groups</span
        >
      </div>
      <div class="mt-auto px-10 pb-10">
        <div
          class="h-32 bg-zinc-950/80 rounded-lg border border-white/5 flex items-end p-4 gap-2 recessed"
        >
          <div class="h-1/2 w-full bg-primary/20 rounded"></div>
          <div class="h-2/3 w-full bg-primary/40 rounded"></div>
          <div class="h-full w-full bg-primary/60 rounded"></div>
          <div class="h-3/4 w-full bg-primary/40 rounded"></div>
        </div>
      </div>
    </article>

    <article
      class="group glass-panel rounded-2xl overflow-hidden flex flex-col hover:border-primary/50 transition-all"
    >
      <div class="p-10 flex justify-between items-start">
        <div>
          <h4 class="font-h3 text-h3 uppercase mb-3">Order Tracking</h4>
          <p class="text-on-surface-variant">
            Visualizes status from "Pending" to "Delivered" in one tap.
          </p>
        </div>
        <span
          class="material-symbols-outlined text-on-surface-variant group-hover:text-primary transition-colors"
          >inventory_2</span
        >
      </div>
      <div class="mt-auto px-10 pb-10">
        <div class="flex gap-4">
          <div
            class="flex-1 h-20 bg-zinc-950/80 border border-white/5 rounded-lg flex items-center justify-center font-mono-label text-primary recessed"
          >
            PENDING
          </div>
          <div
            class="flex-1 h-20 bg-zinc-950/80 border border-white/5 rounded-lg flex items-center justify-center font-mono-label text-emerald-500 recessed"
          >
            DONE
          </div>
        </div>
      </div>
    </article>

    <article
      class="group glass-panel rounded-2xl overflow-hidden flex flex-col hover:border-primary/50 transition-all"
    >
      <div class="p-10 flex justify-between items-start">
        <div>
          <h4 class="font-h3 text-h3 uppercase mb-3">Online Sync Form</h4>
          <p class="text-on-surface-variant">
            Syncs data automatically with your database and notifies you
            instantly.
          </p>
        </div>
        <span
          class="material-symbols-outlined text-on-surface-variant group-hover:text-primary transition-colors"
          >dynamic_form</span
        >
      </div>
      <div class="mt-auto px-10 pb-10">
        <div class="space-y-3">
          <div
            class="w-full h-1.5 bg-white/5 rounded-full overflow-hidden recessed"
          >
            <div
              class="w-2/3 h-full bg-primary shadow-[0_0_10px_rgba(99,102,241,0.5)]"
            >
            </div>
          </div>
          <div
            class="flex justify-between text-[10px] font-mono-label text-outline uppercase tracking-widest"
          >
            <span>SYNCING DATA</span>
            <span>65%</span>
          </div>
        </div>
      </div>
    </article>

    <article
      class="group glass-panel rounded-2xl overflow-hidden flex flex-col hover:border-primary/50 transition-all"
    >
      <div class="p-10 flex justify-between items-start">
        <div>
          <h4 class="font-h3 text-h3 uppercase mb-3">Booking System</h4>
          <p class="text-on-surface-variant">
            Manages calendars effortlessly. Let clients book their own time
            slots.
          </p>
        </div>
        <span
          class="material-symbols-outlined text-on-surface-variant group-hover:text-primary transition-colors"
          >calendar_month</span
        >
      </div>
      <div class="mt-auto px-10 pb-10">
        <div class="grid grid-cols-7 gap-2">
          <div class="h-6 bg-white/5 rounded-sm recessed"></div>
          <div
            class="h-6 bg-primary rounded-sm shadow-[0_0_10px_rgba(99,102,241,0.3)]"
          >
          </div>
          <div class="h-6 bg-white/5 rounded-sm recessed"></div>
          <div class="h-6 bg-white/5 rounded-sm recessed"></div>
          <div
            class="h-6 bg-primary rounded-sm shadow-[0_0_10px_rgba(99,102,241,0.3)]"
          >
          </div>
          <div class="h-6 bg-white/5 rounded-sm recessed"></div>
          <div class="h-6 bg-white/5 rounded-sm recessed"></div>
        </div>
      </div>
    </article>
  </div>
</section>
