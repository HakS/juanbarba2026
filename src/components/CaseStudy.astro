---
import { getLangFromUrl, useTranslations } from '../i18n/ui';

const t = useTranslations(getLangFromUrl(Astro.url)).caseStudy;
---

<section id="case-study" class="max-w-[1280px] mx-auto px-16 py-section-gap">
  <div
    class="glass-panel rounded-3xl p-20 flex flex-col md:flex-row gap-20 items-center border border-white/5"
  >
    <div class="flex-1">
      <span
        class="text-[10px] font-mono-label text-primary uppercase tracking-[0.3em] mb-8 block"
        >{t.eyebrow}</span
      >
      <h2 class="font-h2 text-h2 mb-10 uppercase headline-wide">
        {t.title}
      </h2>
      <blockquote
        class="text-body-lg text-on-surface mb-10 italic leading-relaxed opacity-90 border-l-2 border-primary/30 pl-8"
      >
        {t.quote}
      </blockquote>
      <div class="flex gap-16">
        {
          t.stats.map((s) => (
            <div>
              <span class="block text-4xl font-extrabold text-white mb-2">
                {s.value}
              </span>
              <span class="text-[10px] font-mono-label text-outline uppercase tracking-widest">
                {s.label}
              </span>
            </div>
          ))
        }
      </div>
    </div>
    <div class="flex-1 w-full">
      <div class="recessed rounded-xl p-4 bg-zinc-950/80">
        <img
          class="rounded-lg w-full opacity-70"
          src="/images/casestudy-dashboard.jpg"
          alt={t.imageAlt}
        />
      </div>
    </div>
  </div>
</section>
