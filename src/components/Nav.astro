---
import { WHATSAPP_URL } from '../config/contact';
import { getLangFromUrl, localizedPath, useTranslations } from '../i18n/ui';
import LangSwitch from './LangSwitch.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const homeHref = localizedPath(lang, '/');
const servicesHref = localizedPath(lang, '/services/');
const aboutHref = localizedPath(lang, '/about/');
---

<nav class="fixed top-6 left-0 right-0 z-50 flex justify-center px-4">
  <div
    class="glass-panel h-14 px-8 rounded-full flex items-center gap-6 border border-on-surface/10 bg-surface-container-low/85"
  >
    <a
      href={homeHref}
      class="flex items-center"
      aria-label="Juan Barba"
    >
      <picture>
        <source srcset="/logo-light.svg" media="(prefers-color-scheme: light)" />
        <img src="/logo.svg" alt="Juan Barba" class="h-8 w-auto" />
      </picture>
    </a>
    <div class="h-4 w-px bg-on-surface/10 hidden md:block"></div>
    <div class="hidden md:flex gap-6 items-center">
      <a
        class="text-xs font-mono-label uppercase tracking-widest text-on-surface-variant hover:text-on-surface transition-colors"
        href={servicesHref}>{t.nav.services}</a
      >
      <a
        class="text-xs font-mono-label uppercase tracking-widest text-on-surface-variant hover:text-on-surface transition-colors"
        href={aboutHref}>{t.nav.about}</a
      >
    </div>
    <div class="h-4 w-px bg-on-surface/10 hidden md:block"></div>
    <LangSwitch />
    <div class="h-4 w-px bg-on-surface/10 hidden md:block"></div>
    <a
      href={WHATSAPP_URL}
      target="_blank"
      rel="noopener"
      class="text-[10px] font-mono-label uppercase tracking-[0.2em] text-primary hover:text-on-surface transition-colors"
      >{t.nav.message}</a
    >
  </div>
</nav>
