---
import { WHATSAPP_URL } from '../config/contact';
import { getLangFromUrl, useTranslations } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const philosophy = t.philosophy;
const background = t.background;
---

<section class="max-w-[1280px] mx-auto px-6 sm:px-10 md:px-16 py-section-gap">
  <div class="max-w-3xl mb-16">
    <span
      class="text-[10px] font-mono-label text-primary uppercase tracking-[0.3em] mb-6 block"
      >{philosophy.eyebrow}</span
    >
    <h2 class="font-h2 text-h2 text-on-surface uppercase headline-wide">
      {philosophy.title}
    </h2>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-16 mb-32">
    {
      philosophy.principles.map((p, i) => (
        <article
          class="space-y-4"
          data-reveal
          style={`--reveal-delay: ${i * 90}`}
        >
          <span class="text-5xl font-extrabold text-on-surface/10 block leading-none">
            {String(i + 1).padStart(2, '0')}
          </span>
          <h3 class="font-h3 text-xl text-on-surface font-bold">{p.title}</h3>
          <p class="text-on-surface-variant leading-relaxed">{p.body}</p>
        </article>
      ))
    }
  </div>
  <div class="glass-panel rounded-2xl p-10 sm:p-16 border border-on-surface/10 grid grid-cols-1 md:grid-cols-3 gap-12 items-center">
    <div class="md:col-span-2 space-y-6">
      <span
        class="text-[10px] font-mono-label text-primary uppercase tracking-[0.3em] block"
        >{background.eyebrow}</span
      >
      <h2 class="font-h2 text-h2 text-on-surface uppercase headline-wide">
        {background.title}
      </h2>
      <p class="text-body-lg text-on-surface-variant leading-relaxed">
        {background.body}
      </p>
    </div>
    <a
      href={WHATSAPP_URL}
      target="_blank"
      rel="noopener"
      class="text-sm font-mono-label uppercase tracking-[0.2em] text-primary hover:text-on-surface transition-colors text-left md:text-right"
      >{background.cta}</a
    >
  </div>
</section>
