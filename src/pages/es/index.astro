---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Hero from '../../components/Hero.astro';
import Problem from '../../components/Problem.astro';
import Solution from '../../components/Solution.astro';
import Examples from '../../components/Examples.astro';
import CaseStudy from '../../components/CaseStudy.astro';
import FAQ from '../../components/FAQ.astro';
import FinalCTA from '../../components/FinalCTA.astro';
import Footer from '../../components/Footer.astro';
import JsonLd from '../../components/JsonLd.astro';
import { ui, useTranslations } from '../../i18n/ui';
import {
  faqSchema,
  graph,
  localBusinessSchema,
  personSchema,
  websiteSchema,
} from '../../lib/schema';

const t = useTranslations('es').meta.home;
const site = Astro.site ?? new URL('https://juanbarba.vercel.app');
const homeFaq = ui.es.faq.items.slice(0, 3);
const schema = graph(
  websiteSchema(site, 'es'),
  localBusinessSchema(site, 'es'),
  personSchema(site, 'es'),
  faqSchema(homeFaq),
);
---

<Layout title={t.title} description={t.description} canonical="/es/">
  <Fragment slot="head">
    <JsonLd data={schema} />
  </Fragment>
  <Nav />
  <main class="pt-32">
    <Hero />
    <Problem />
    <CaseStudy />
    <Solution />
    <Examples />
    <FAQ limit={3} showCta />
    <FinalCTA />
  </main>
  <Footer />
</Layout>
