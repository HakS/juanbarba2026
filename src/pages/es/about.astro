---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import About from '../../components/About.astro';
import Philosophy from '../../components/Philosophy.astro';
import FinalCTA from '../../components/FinalCTA.astro';
import Footer from '../../components/Footer.astro';
import JsonLd from '../../components/JsonLd.astro';
import { ui, useTranslations } from '../../i18n/ui';
import {
  breadcrumbSchema,
  graph,
  localBusinessSchema,
  personSchema,
} from '../../lib/schema';

const t = useTranslations('es').meta.about;
const site = Astro.site ?? new URL('https://juanbarba.vercel.app');
const breadcrumb = ui.es.breadcrumb;
const schema = graph(
  localBusinessSchema(site, 'es'),
  personSchema(site, 'es'),
  breadcrumbSchema(site, 'es', [
    { name: breadcrumb.home, path: '/es/' },
    { name: breadcrumb.about, path: '/es/about/' },
  ]),
);
---

<Layout title={t.title} description={t.description} canonical="/es/about/">
  <Fragment slot="head">
    <JsonLd data={schema} />
  </Fragment>
  <Nav />
  <main class="pt-32">
    <About headingLevel="h1" />
    <Philosophy />
    <FinalCTA />
  </main>
  <Footer />
</Layout>
