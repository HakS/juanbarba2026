---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Services from '../../components/Services.astro';
import Solution from '../../components/Solution.astro';
import Examples from '../../components/Examples.astro';
import Process from '../../components/Process.astro';
import Pricing from '../../components/Pricing.astro';
import FAQ from '../../components/FAQ.astro';
import FinalCTA from '../../components/FinalCTA.astro';
import Footer from '../../components/Footer.astro';
import JsonLd from '../../components/JsonLd.astro';
import { ui, useTranslations } from '../../i18n/ui';
import {
  breadcrumbSchema,
  faqSchema,
  graph,
  localBusinessSchema,
  serviceSchema,
} from '../../lib/schema';

const t = useTranslations('es').meta.services;
const site = Astro.site ?? new URL('https://juanbarba.vercel.app');
const breadcrumb = ui.es.breadcrumb;
const schema = graph(
  localBusinessSchema(site, 'es'),
  serviceSchema(site, 'es'),
  faqSchema(ui.es.faq.items),
  breadcrumbSchema(site, 'es', [
    { name: breadcrumb.home, path: '/es/' },
    { name: breadcrumb.services, path: '/es/services/' },
  ]),
);
---

<Layout title={t.title} description={t.description} canonical="/es/services/">
  <Fragment slot="head">
    <JsonLd data={schema} />
  </Fragment>
  <Nav />
  <main class="pt-32">
    <Services headingLevel="h1" />
    <Solution />
    <Examples />
    <Process />
    <Pricing />
    <FAQ />
    <FinalCTA />
  </main>
  <Footer />
</Layout>
